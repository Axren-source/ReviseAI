# Resend secret key (Dashboard -> API Keys)
# Place your real key in `.env.local` for local dev and in Vercel Project Settings -> Environment Variables for production.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Verified sender in Resend (must be verified domain/sender)
WAITLIST_FROM_EMAIL=ReviseAI <waitlist@yourdomain.com>

# Inbox that should receive instant signup notifications
WAITLIST_NOTIFY_EMAIL=founder@yourdomain.com
